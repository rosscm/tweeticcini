[Unit]
Description=Tweeticcini dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Documents/GitHub/tweeticcini
EnvironmentFile=/home/pi/Documents/GitHub/tweeticcini/.env
ExecStart=/home/pi/Documents/GitHub/tweeticcini/.venv/bin/python -m uvicorn src.dashboard_api.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
