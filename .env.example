BOT_TOKEN=your_discord_bot_token
# Optional fallback for legacy/shared delivery sessions only:
TWITTER_TOKEN=tweeticcini:your_twitter_auth_token
# Required to encrypt server-connected Twitter/X sessions stored by the dashboard:
TWITTER_SESSION_SECRET=replace_with_a_long_random_string
DATA_PATH=./data
PUBLIC_SITE_URL=https://your-public-site.example
APP_ENV=production
ALLOW_UNAUTHENTICATED_DASHBOARD=false

# Local dashboard example:
# DISCORD_REDIRECT_URI=http://localhost:8000/dashboard/callback
# Production dashboard example:
# DISCORD_REDIRECT_URI=https://app.tweeticcini.com/dashboard/callback
# Optional public dashboard base used by the /dashboard slash command:
# DASHBOARD_BASE_URL=https://app.tweeticcini.com
# Optional support server invite used by /about:
# SUPPORT_SERVER_URL=https://discord.gg/yourinvite
# TOP_GG_VOTE_URL=https://top.gg/bot/your-bot-id/vote
# Optional comma-separated server IDs that should receive support/vote footer nudges
# even when they are not on the free plan:
# SUPPORT_PROMPT_SERVER_IDS=1254856467744297062,1329829171173789827
# Optional custom vote prompt text used only for SUPPORT_PROMPT_SERVER_IDS servers:
# SUPPORT_PROMPT_MANAGED_SERVER_TEXT=Enjoying Tweeticcini? Vote on top.gg! It would make Mocha's day 💛
# Optional server:channel pairs to restrict vote prompt placement to specific channels:
# SUPPORT_PROMPT_CHANNEL_OVERRIDES=1254856467744297062:1396358762738221126
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_REDIRECT_URI=http://localhost:8000/dashboard/callback
DASHBOARD_BASE_URL=
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_string
DASHBOARD_INTERNAL_ADMIN_SECRET=
SUPPORT_SERVER_URL=
TOP_GG_VOTE_URL=
SUPPORT_PROMPT_SERVER_IDS=
SUPPORT_PROMPT_MANAGED_SERVER_TEXT=
SUPPORT_PROMPT_CHANNEL_OVERRIDES=
DELIVERY_OUTBOX_RETRY_BASE_SECONDS=30
DELIVERY_OUTBOX_RETRY_MAX_SECONDS=900
DELIVERY_OUTBOX_MAX_ATTEMPTS=5
DELIVERY_OUTBOX_POLL_SECONDS=15
DELIVERY_OUTBOX_LEASE_SECONDS=120

# Use matching Stripe modes together:
# Test mode: pk_test / sk_test / whsec (test webhook) / test price_...
# Live mode: pk_live / sk_live / whsec (live webhook) / live price_...
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_PLUS=price_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me
